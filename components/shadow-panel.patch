 static gboolean
+panel_dbus_service_add_launcher_to_panel (XfcePanelExportedService *skeleton,
+                                         GDBusMethodInvocation *invocation,
+                                         guint panel_id,
+                                         const gchar *desktop_uri,
+                                         PanelDBusService *service)
+{
+  GFile *file = g_file_new_for_uri (desktop_uri);
+  gchar *name = g_file_get_basename (file);
+  gboolean valid = g_file_is_native (file) && name != NULL
+                   && g_str_has_suffix (name, ".desktop")
+                   && g_file_query_file_type (file, G_FILE_QUERY_INFO_NONE, NULL) == G_FILE_TYPE_REGULAR;
+  g_free (name);
+  g_object_unref (file);
+  if (!valid)
+    {
+      g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_INVALID_ARGS,
+                                             "Choose a local application launcher.");
+      return TRUE;
+    }
+
+  PanelApplication *application = panel_application_get ();
+  PanelWindow *window = panel_application_get_window (application, panel_id);
+  if (window == NULL || panel_application_get_locked (application)
+      || panel_window_get_locked (window))
+    {
+      g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_ACCESS_DENIED,
+                                             "The requested panel is unavailable or locked.");
+      g_object_unref (application);
+      return TRUE;
+    }
+
+  gchar *arguments[] = { (gchar *) desktop_uri, NULL };
+  panel_application_add_new_item (application, window, "launcher", arguments);
+  g_object_unref (application);
+  xfce_panel_exported_service_complete_add_launcher_to_panel (skeleton, invocation);
+  return TRUE;
+}
