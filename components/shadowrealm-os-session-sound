#!/usr/bin/python3
import json,sys,subprocess
from pathlib import Path
try:s=json.loads((Path.home()/'.config/shadowrealm-os/experience.json').read_text())
except (OSError,ValueError):s={}
kind=sys.argv[1] if len(sys.argv)>1 else 'login'
if kind not in ('login','logout','preview'):sys.exit(2)
if kind!='preview' and not s.get(kind,True):sys.exit(0)
try:
 volume=max(0,min(60,int(s.get('volume',25))))
 subprocess.run(['paplay','--volume='+str(int(volume/100*65536)),'/usr/share/sounds/ShadowRealm-OS/stereo/desktop-'+('logout' if kind=='logout' else 'login')+'.wav'],timeout=4,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
except (OSError,ValueError,subprocess.TimeoutExpired):pass
