  def display(data):
   self.apps.clear();self.components.clear();self.sources.clear()
   for row in data[0]:self.apps.append(row)
   self.components.append(('Running Linux kernel',platform.release(),'Debian APT · reboot after kernel updates'))
   self.components.append(('Shadow Link','Built-in','ShadowRealm-OS menu, widgets and control panels'))
   for row in data[1]:self.sources.append(row)
   for row in data[2]:self.sources.append(row)
   self.status.set_text(f'{len(data[0])} installed applications · {len(data[1])} APT sources.');self.app_selected()
  self.work('Reading installed software…',load,display)
