  dialog=Gtk.MessageDialog(transient_for=self.window,modal=True,message_type=Gtk.MessageType.QUESTION,buttons=Gtk.ButtonsType.OK_CANCEL,text=title);dialog.format_secondary_text(message);answer=dialog.run();dialog.destroy();return answer==Gtk.ResponseType.OK
 def remove_app(self,*unused):
