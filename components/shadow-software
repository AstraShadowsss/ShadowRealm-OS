def command(args,timeout=120):
 r=subprocess.run(args,text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=timeout)
 if r.returncode:raise RuntimeError((r.stderr or r.stdout or 'The operation failed.').strip()[-3000:])
 return r.stdout
def rows(text,columns):
 return [line.split('\t',columns-1) for line in text.splitlines() if line.strip() and len(line.split('\t',columns-1))==columns]
def installed():
 flat=rows(command(['flatpak','list','--app','--columns=application,name,version,installation']),4)
 result=[(name,version or 'Not provided','Flatpak · '+scope,identity,True) for identity,name,version,scope in flat]
 ids={r[3] for r in result}
 try:versions=json.loads(pathlib.Path('/var/lib/shadowrealm-os/application-versions.json').read_text())
 except (OSError,ValueError):versions={}
 owners={}
 ownership=subprocess.run(['/usr/bin/dpkg-query','-S','/usr/share/applications/*.desktop','/usr/bin/*'],
                          capture_output=True,text=True,check=False)
 for line in ownership.stdout.splitlines():
  owner,separator,filename=line.partition(': ')
  if separator:owners[filename]=owner.split(', ',1)[0]
 native_versions={}
 packages=command(['/usr/bin/dpkg-query','-W','-f=${binary:Package}\t${Version}\n'])
 for package,version in rows(packages,2):native_versions[package]=version
 for app in Gio.AppInfo.get_all():
  if not app.should_show() or app.get_id()=='shadow-link.desktop' or (app.get_id() or '').removesuffix('.desktop') in ids:continue
  if not isinstance(app,GioUnix.DesktopAppInfo):continue
  executable=pathlib.Path(app.get_executable() or '').name.lower();version=versions.get(executable,app.get_string('X-AppVersion') or 'Not recorded');source='Native application'
  filename=str(pathlib.Path(app.get_filename()).resolve()) if app.get_filename() else ''
  owner=owners.get(filename) or (owners.get('/usr/bin/'+executable) if executable not in {'xfce4-terminal','xdg-open'} else None)
  if owner in native_versions:version=native_versions[owner];source='Native package'
  if (app.get_id() or '').startswith('shadow-') and 'shadow-link' in (app.get_commandline() or ''):version='Built-in';source='ShadowRealm-OS application'
  result.append((app.get_display_name(),version,source,app.get_id(),False))
 names={r[0].casefold() for r in result}
 for key,(name,args) in BUILTINS.items():
  if name.casefold() not in names and (BASE/args[0]).is_file():result.append((name,'Built-in','ShadowRealm-OS application','builtin:'+key,False))
 return sorted(result,key=lambda r:r[0].casefold())
def debian_updates():
 import apt
 cache=apt.Cache()
 result=[]
 for package in cache:
  if not package.is_upgradable or not package.candidate or not package.installed:continue
  origins=package.candidate.origins
  security=any(origin.origin=='Debian' and
               (origin.archive.endswith('-security') or origin.codename.endswith('-security'))
               for origin in origins)
  channel='Debian Security' if security else next(
   (origin.label for origin in origins if origin.label),'APT')
  result.append((package.name,package.installed.version,package.candidate.version,channel))
 return sorted(result,key=lambda row:(row[3]!='Debian Security',row[0]))

def debian_sources():
 import apt_pkg
 apt_pkg.init()
 sources=apt_pkg.SourceList();sources.read_main_list()
 return [('Debian/APT',source.uri,source.dist) for source in sources.list]

