 def update_status(self,*unused):
  try:
   cfg=command(['apt-config','shell','PERIOD','APT::Periodic::Unattended-Upgrade'],10)
   period=shlex.split(cfg.partition('=')[2].rstrip(';\n'))
   timer=command(['systemctl','is-enabled','apt-daily-upgrade.timer'],10).strip()
   automatic='Enabled' if period and period[0].isdigit() and int(period[0])>0 and timer=='enabled' else 'Off or not scheduled'
  except (RuntimeError,subprocess.SubprocessError,OSError):
   automatic='Unknown'
  reboot='Restart requested' if pathlib.Path('/run/reboot-required').exists() else 'No restart flag reported'
  try:
   with open('/var/log/apt/history.log',encoding='utf-8',errors='replace') as log:
    log.seek(max(0,os.fstat(log.fileno()).st_size-24000))
    history=log.read().strip()
  except OSError:
   history='APT history is unavailable.'
  self.details('Update Status & History',f'Automatic Debian updates: {automatic}\n{reboot}\nRunning kernel: {platform.release()}\n\nRecent APT activity\n\n{history}')
 def flatpak_permissions(self,*unused):
  row=self.selected(self.appview)
  if not row or not row[4]:return
  scope='--user' if row[2].endswith('user') else '--system'
  try:
   declared=command(['flatpak','info',scope,'--show-permissions',row[3]],10)
   overrides=command(['flatpak','override','--user','--show',row[3]],10)
   system=command(['flatpak','override','--system','--show',row[3]],10)
   self.details(row[0]+' permissions',f'Declared permissions\n{declared}\nSystem app overrides\n{system or "None"}\nUser app overrides\n{overrides or "None"}')
  except (RuntimeError,subprocess.SubprocessError,OSError) as error:
   self.status.set_text(str(error))
 def open_app(self,*unused):
  row=self.selected(self.appview)
  if not row:return
  try:
   if row[3].startswith('builtin:'):
    args=BUILTINS[row[3].split(':',1)[1]][1];subprocess.Popen([str(BASE/args[0])]+args[1:])
   else:
    app=GioUnix.DesktopAppInfo.new(row[3]+'.desktop' if row[4] else row[3]);assert app,'Application launcher was not found.';app.launch([],None)
   self.status.set_text('Opened '+row[0]+'.')
  except Exception as error:self.status.set_text(str(error))
