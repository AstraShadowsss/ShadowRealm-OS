 def table(self,tabs,label,titles,types):
  page=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=12,margin=12);tabs.append_page(page,Gtk.Label(label=label))
  model=Gtk.ListStore(*types);view=Gtk.TreeView(model=model);view.set_headers_visible(True)
  for i,title in enumerate(titles):
   renderer=Gtk.CellRendererText();renderer.set_property('ellipsize',3);column=Gtk.TreeViewColumn(title,renderer,text=i);column.set_resizable(True);column.set_expand(i==0);column.set_min_width(200 if title=='Source' else 160 if 'ersion' in title else 100);view.append_column(column)
  scroll=Gtk.ScrolledWindow();scroll.set_policy(Gtk.PolicyType.AUTOMATIC,Gtk.PolicyType.AUTOMATIC);scroll.add(view);page.pack_start(scroll,True,True,0)
  return model,view,page
 def button(self,box,label,callback):
  b=Gtk.Button(label=label);b.connect('clicked',callback);box.pack_start(b,False,False,0);return b
 def work(self,label,job,done=None):
  if self.busy:self.status.set_text('An operation is already running.');return
  self.busy=True;self.spinner.start();self.status.set_text(label)
  def complete(future):
   try:answer=(True,future.result())
   except Exception as error:answer=(False,str(error))
   GLib.idle_add(self.finished,answer,done)
  POOL.submit(job).add_done_callback(complete)
 def finished(self,answer,done):
  self.busy=False;self.spinner.stop()
  if not answer[0]:
   self.status.set_text(answer[1])
   if self.update_message.get_text().startswith('Looking for'):
    self.update_message.set_text('Update check failed. See the message below and try again.')
   return False
  if done:done(answer[1])
  else:
   from shadow_flatpak_exports import sync_exports
   sync_exports()
   self.status.set_text('Operation completed.');self.refresh()
  return False
 def refresh(self,*unused):
