   result=command(['/usr/bin/apt-cache','search','--names-only',re.escape(query)])
   return [line.split(' - ',1) for line in result.splitlines() if ' - ' in line][:250]
  def show(packages):
   self.debian_catalog.clear()
   for package in packages:self.debian_catalog.append(package)
