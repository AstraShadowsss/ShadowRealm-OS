  self.work('Removing '+row[0]+'…',lambda:command(['flatpak','uninstall',scope,'--noninteractive',row[3]],900))
 def check_updates(self,*unused):
  if self.busy:return
  self.updates.clear();self.apply_button.set_sensitive(False)
  self.update_message.set_text('Looking for Flatpak app and runtime updates…')
  def load():
   result=[]
   for scope in ['--system','--user']:
    for identity,name,version in rows(command(['flatpak','remote-ls',scope,'--updates','--columns=application,name,version']),3):
     result.append((name or identity,version or 'Version not provided','Flatpak '+scope[2:]))
   return result
  def show(result):
   for row in result:self.updates.append(row)
   self.apply_button.set_sensitive(bool(result))
   self.update_message.set_text(f'{len(result)} Flatpak updates available.' if result else 'Flatpak apps and runtimes are up to date.')
   self.status.set_text('Flatpak update check completed.')
  self.work('Checking Flatpak update sources…',load,show)
 def apply_updates(self,*unused):
  if self.busy:return
  scopes=sorted({'--'+row[2].split()[-1] for row in self.updates})
  if not scopes or not self.confirm('Apply available Flatpak updates?','This updates Flatpak apps and runtimes.'):return
  self.apply_button.set_sensitive(False)
  def update():
   for scope in scopes:command(['flatpak','update',scope,'--noninteractive'],1800)
  self.work('Applying Flatpak updates. An administrator prompt may appear…',update,lambda *_:self.check_updates())
 def search(self,*unused):
  query=self.query.get_text().strip()
  if not query:return
  def show(result):
   self.catalog.clear()
   for identity,name,description in rows(result,3):self.catalog.append((name,description,identity))
   self.status.set_text(f'{len(self.catalog)} matching applications from configured Flatpak sources.')
  self.work('Searching Flathub…',lambda:command(['flatpak','search','--columns=application,name,description',query],180),show)
 def install_app(self,*unused):
  row=self.selected(self.catalogview)
  if not row:return
  if not re.fullmatch(r'[A-Za-z0-9_.-]+',row[2]):return
  if not self.confirm('Install '+row[0]+'?','Source: Flathub. Required shared runtimes will also be installed. An administrator prompt may appear.'):return
  def install():
   user_sources=command(['flatpak','remotes','--user','--columns=name']).splitlines()
   scope='--user' if 'flathub' in user_sources else '--system'
   return command(['flatpak','install',scope,'--noninteractive','flathub',row[2]],1800)
  self.work('Installing '+row[0]+'…',install)
