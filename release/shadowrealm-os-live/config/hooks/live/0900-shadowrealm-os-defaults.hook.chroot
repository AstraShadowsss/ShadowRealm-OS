#!/bin/sh
set -eu
# Retain system DNS until the user selects a different resolver.
systemctl --root=/ mask dnscrypt-proxy-resolvconf.service
if [ -f /etc/dnscrypt-proxy/dnscrypt-proxy.toml ]; then
    sed -i '/^[[:space:]]*file = .*\/dnscrypt-proxy\/\(query\|nx\)\.log/d' /etc/dnscrypt-proxy/dnscrypt-proxy.toml
fi
# Tor Browser manages its own connection; the system Tor service is opt-in.
systemctl --root=/ disable tor.service
/usr/sbin/plymouth-set-default-theme shadowrealm-os

# Apply Debian security updates daily. Reboots remain under user control.
cat > /etc/apt/apt.conf.d/52shadowrealm-os-security-updates <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
    "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
};
Unattended-Upgrade::Automatic-Reboot "false";
EOF

install -d /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-shadowrealm-os-users.conf <<'EOF'
[Seat:*]
greeter-hide-users=false
greeter-show-manual-login=true
allow-guest=false
EOF
